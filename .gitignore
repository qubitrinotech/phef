# Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Виртуальные окружения
.venv/
venv/
venv*/
env/
.env

# Логи и большие файлы
*.log
logs/
*.pt
*.pth
*.ckpt
*.safetensors

# Результаты экспериментов (можно закомментировать, если нужно загрузить)
results/
results_*/
output/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Git
*.orig

# результаты PHEF версионируем принудительно.
# Порядок важен: git не заходит в исключённый каталог, поэтому сначала
# надо вернуть сами каталоги, и только потом их содержимое.
!phef/results/
!phef/results/**
!phef/logs/
!phef/logs/**

# веса всё равно не версионируем, они большие
phef/results/**/*.ckpt
phef/results/**/*.safetensors
