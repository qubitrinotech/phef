"""
Training script for the Holographic Memory AGI prototype.
FIXED: works with the non-in-place FractalPositionalEncoding; memory loss no
longer tries to backprop through a detached memory snapshot.
"""

import sys
import os
sys.path.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), '..'))

import argparse
import torch
import torch.nn as nn
from torch.utils.data import DataLoader, Dataset
import numpy as np
from tqdm import tqdm

from core.holographic_memory import AGICore, HolographicFeatureDistiller

try:
    import matplotlib
    matplotlib.use("Agg")
    import matplotlib.pyplot as plt
    MATPLOTLIB_AVAILABLE = True
except ImportError:
    MATPLOTLIB_AVAILABLE = False
    print("matplotlib not available, skipping visualizations")


class SyntheticSequenceDataset(Dataset):
    """Synthetic dataset for testing memory capabilities."""

    def __init__(self, num_samples: int, seq_len: int, vocab_size: int):
        self.data = torch.randint(0, vocab_size, (num_samples, seq_len))

    def __len__(self):
        return len(self.data)

    def __getitem__(self, idx):
        return self.data[idx]


def train_epoch(model, dataloader, optimizer, device, detect_anomaly: bool = False) -> float:
    model.train()
    criterion = nn.CrossEntropyLoss()
    total_loss = 0.0
    num_batches = 0

    with torch.autograd.set_detect_anomaly(detect_anomaly, check_nan=False):
        for batch in tqdm(dataloader, desc="Training"):
            batch = batch.to(device, non_blocking=True)
            model.reset_memory()

            optimizer.zero_grad(set_to_none=True)

            logits, _ = model(batch)

            loss = criterion(
                logits[:, :-1].reshape(-1, logits.size(-1)),
                batch[:, 1:].reshape(-1),
            )

            loss.backward()
            torch.nn.utils.clip_grad_norm_(model.parameters(), 1.0)
            optimizer.step()

            total_loss += loss.item()
            num_batches += 1

    return total_loss / max(num_batches, 1)


@torch.no_grad()
def test_memory_retention(model, device, vocab_size: int = 1000, seq_len: int = 512):
    print("\n" + "=" * 50)
    print("Testing Memory Retention")
    print("=" * 50)
    model.eval()

    model.reset_memory()
    sequence1 = torch.randint(0, vocab_size, (1, seq_len), device=device)
    sequence1[0, 0] = 42
    logits1, memory_state1 = model(sequence1)

    model.reset_memory()
    sequence2 = torch.randint(0, vocab_size, (1, seq_len), device=device)
    sequence2[0, 0] = 99
    logits2, memory_state2 = model(sequence2)

    if memory_state1 is not None and memory_state2 is not None:
        difference = torch.norm(memory_state1 - memory_state2).item()
        print(f"Memory difference between sequences: {difference:.4f}")
        print(f"Memory state 1 norm: {memory_state1.norm().item():.4f}")
        print(f"Memory state 2 norm: {memory_state2.norm().item():.4f}")

    print("\nSequence 1 (marker=42):")
    print(f"  First 5 tokens: {sequence1[0, :5].tolist()}")
    print(f"  Top 5 predictions at end: {logits1[0, -1].topk(5).indices.tolist()}")

    print("\nSequence 2 (marker=99):")
    print(f"  First 5 tokens: {sequence2[0, :5].tolist()}")
    print(f"  Top 5 predictions at end: {logits2[0, -1].topk(5).indices.tolist()}")

    return memory_state1, memory_state2


@torch.no_grad()
def visualize_memory_evolution(model, device, out_path: str = "memory_evolution.png"):
    if not MATPLOTLIB_AVAILABLE:
        print("Skipping visualization (matplotlib not available)")
        return

    print("\n" + "=" * 50)
    print("Visualizing Memory Evolution")
    print("=" * 50)
    model.eval()

    patterns = {
        "repeating": torch.tensor([[1, 2, 3, 1, 2, 3] * 20], device=device),
        "increasing": (torch.arange(120, device=device).unsqueeze(0) % 1000),
        "random": torch.randint(0, 1000, (1, 120), device=device),
    }

    memory_states = {}
    for name, seq in patterns.items():
        model.reset_memory()
        _, memory = model(seq)
        if memory is not None:
            memory_states[name] = memory.cpu().numpy()

    if not memory_states:
        return

    fig, axes = plt.subplots(1, len(memory_states), figsize=(5 * len(memory_states), 4))
    axes = np.atleast_1d(axes)
    for ax, (name, state) in zip(axes, memory_states.items()):
        vals = state.flatten()[:100]
        ax.plot(vals, alpha=0.8)
        ax.fill_between(range(len(vals)), vals, alpha=0.3)
        ax.set_title(f"Memory Pattern: {name}")
        ax.set_xlabel("Dimension")
        ax.set_ylabel("Activation")
        ax.grid(True, alpha=0.3)

    plt.suptitle("Hysteresis Memory States for Different Sequences")
    plt.tight_layout()
    plt.savefig(out_path, dpi=150, bbox_inches="tight")
    plt.close()
    print(f"Saved memory evolution plot to '{out_path}'")


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--epochs", type=int, default=10)
    parser.add_argument("--batch-size", type=int, default=8)
    parser.add_argument("--seq-len", type=int, default=128)
    parser.add_argument("--hidden-dim", type=int, default=256)
    parser.add_argument("--num-layers", type=int, default=3)
    parser.add_argument("--vocab-size", type=int, default=1000)
    parser.add_argument("--lr", type=float, default=1e-3)
    parser.add_argument("--detect-anomaly", action="store_true")
    parser.add_argument("--seed", type=int, default=42)
    args = parser.parse_args()

    torch.manual_seed(args.seed)
    np.random.seed(args.seed)

    print("=" * 60)
    print("AGI Holographic Memory - Training Experiment")
    print("=" * 60)

    device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
    print(f"\nUsing device: {device}")
    if device.type == "cuda":
        print(f"  GPU: {torch.cuda.get_device_name(0)}")
        print(f"  Memory: {torch.cuda.get_device_properties(0).total_memory / 1e9:.1f} GB")

    print("\nInitializing model...")
    model = AGICore(
        vocab_size=args.vocab_size,
        hidden_dim=args.hidden_dim,
        num_layers=args.num_layers,
    ).to(device)

    print(f"  Total parameters: {sum(p.numel() for p in model.parameters()):,}")
    print(f"  Trainable parameters: {sum(p.numel() for p in model.parameters() if p.requires_grad):,}")

    dataset = SyntheticSequenceDataset(1000, args.seq_len, args.vocab_size)
    dataloader = DataLoader(dataset, batch_size=args.batch_size, shuffle=True, drop_last=True)

    optimizer = torch.optim.AdamW(model.parameters(), lr=args.lr)
    scheduler = torch.optim.lr_scheduler.CosineAnnealingLR(optimizer, T_max=args.epochs)

    print("\nStarting Training")
    print("-" * 50)

    losses = []
    for epoch in range(args.epochs):
        loss = train_epoch(model, dataloader, optimizer, device, args.detect_anomaly)
        losses.append(loss)
        scheduler.step()
        print(f"Epoch {epoch + 1}/{args.epochs} | Loss: {loss:.4f} | LR: {scheduler.get_last_lr()[0]:.6f}")

        if epoch % 3 == 0 or epoch == args.epochs - 1:
            test_memory_retention(model, device, args.vocab_size)

    print("\n" + "=" * 60)
    print("Final Evaluation")
    print("=" * 60)
    test_memory_retention(model, device, args.vocab_size)
    visualize_memory_evolution(model, device)

    if MATPLOTLIB_AVAILABLE:
        plt.figure(figsize=(10, 5))
        plt.plot(losses, marker="o", linewidth=2, markersize=8)
        plt.xlabel("Epoch")
        plt.ylabel("Loss")
        plt.title("Training Loss - Holographic Memory Model")
        plt.grid(True, alpha=0.3)
        plt.tight_layout()
        plt.savefig("training_loss.png", dpi=150, bbox_inches="tight")
        plt.close()
        print("Saved training loss plot to 'training_loss.png'")

    torch.save({
        "model_state_dict": model.state_dict(),
        "optimizer_state_dict": optimizer.state_dict(),
        "losses": losses,
        "config": {
            "vocab_size": args.vocab_size,
            "hidden_dim": args.hidden_dim,
            "num_layers": args.num_layers,
        },
    }, "agi_prototype.pt")
    print("\nModel saved to 'agi_prototype.pt'")

    print("\n" + "=" * 60)
    print("Experiment Complete!")
    print("=" * 60)


if __name__ == "__main__":
    main()